# Ambiente SEFAZ: homologacao (testes) | producao
NFE_AMBIENTE=homologacao
UF=SP
CNPJ_INTERESSADO=00000000000000

# Certificado digital A1 (arquivo .pfx)
CERTIFICADO_ARQUIVO=certs/meu-certificado.pfx
CERTIFICADO_SENHA=troque-essa-senha

# SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_DB=GestorEssencialNFe
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=sua-senha
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_TRUST_CERT=true

# Armazenamento
PASTA_XML=storage/xml
PASTA_PDF=storage/pdf

# Token da API (gere um valor forte: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_TOKEN=troque-por-um-token-forte